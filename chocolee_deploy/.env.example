# Django 設定
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# 資料庫配置 (MySQL - Kubernetes)
DATABASE_NAME=kube5gnfvo
DATABASE_USER=root
DATABASE_PASSWORD=password
DATABASE_HOST=kube5gnfvo-mysql.kube5gnfvo.svc.cluster.local
DATABASE_PORT=3306

# Kubernetes 配置
KUBECONFIG=/home/ubuntu/.kube/config

# etcd 配置
ETCD_HOST=localhost
ETCD_PORT=2379

# 應用配置
LANGUAGE_CODE=en-us
TIME_ZONE=Asia/Taipei
USE_I18N=True
USE_TZ=True
